# OpenAI Configuration
OPENAI_API_KEY=sk-your-openai-api-key

# Supabase JWT Secret (found in Supabase Dashboard > Settings > API > JWT Secret)
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# Database Connection
# Local: postgresql://postgres:password@localhost:5432/fluxai
# Production: postgresql://postgres:[password]@db.your-project.supabase.co:5432/postgres
DATABASE_URL=postgresql://postgres:password@localhost:5432/fluxai

# CORS Allowed Origins
ALLOWED_ORIGINS=http://localhost:5173,https://your-vercel-domain.vercel.app

# Note: For production deployment, update DATABASE_URL to point to your
# organization's Supabase project (qalyai)
