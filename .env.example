# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# FastAPI backend (Groq → Gemini → Kimi AI — Bug Refiner, Test Case Gen, Writing Assistant)
VITE_FASTAPI_URL=http://localhost:8000

# Session Timeout Configuration
VITE_SESSION_IDLE_TIMEOUT_MS=300000     # 5 minutes
VITE_SESSION_WARNING_SECONDS=30         # 30 seconds

# Note: For production deployment (Vercel), set these as environment variables
# in the Vercel dashboard pointing to your organization's Supabase project
